# Copy values for local docs only. Flutter does not load .env automatically.
# Pass the key at run/build time:
#
#   flutter run --dart-define=SUPABASE_ANON_KEY=sb_publishable_...
#   flutter build apk --release --dart-define=SUPABASE_ANON_KEY=sb_publishable_...
#
# Get the publishable key from:
#   Supabase → Project Settings → API → Publishable / anon key
#
# Never commit a filled .env or put the service_role key in the app.

SUPABASE_URL=https://kaiffjdbfjkjqisumklh.supabase.co
SUPABASE_ANON_KEY=sb_publishable_REPLACE_ME
