# Copy to .env.local (gitignored). Flutter does not load .env files automatically.
#
# Local Flutter run (uses key from .env.local):
#   ./scripts/flutter_run_local.sh
#   ./scripts/flutter_run_local.sh -d macos
#
# Manual run/build (paste key from Supabase dashboard, not into this file):
#   flutter run --dart-define=SUPABASE_ANON_KEY=<publishable-key>
#
# Upsert reference tables (needs service_role in .env.local):
#   python3 scripts/upsert_reference_data.py
#
# Keys: Supabase → Project Settings → API
# Never commit a filled .env.local or put service_role in the app.

# Copy lines below into .env.local with real values — never put real keys in this file.
# Either naming works in .env.local:
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Scripts only (never commit real values, never put in the Flutter app):
SUPABASE_SERVICE_ROLE_KEY=
# Optional: auto-apply migration 003 before exercise upsert (psql must be installed)
# DATABASE_URL=postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres